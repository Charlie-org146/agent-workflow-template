#!/usr/bin/env python3
# Test double for gh, for the deliver-first toys: issues, paged lists, comments with an author, faults. Dev only; never packaged.
# State: $DLF_FAKE_DIR/state.json. $DLF_FAKE_AS is the login a write is made as (default loopbot); $DLF_PAGE the page size (default 2).
# Faults: DLF_FAKE_FAIL=list|issues|comments (that read fails), DLF_FAKE_TIMEOUT=1 (the next comment is stored, then gh fails).
import json
import os
import sys

d = os.environ["DLF_FAKE_DIR"]
path = os.path.join(d, "state.json")
args = sys.argv[1:]
open(os.path.join(d, "calls.log"), "a").write(json.dumps(args) + "\n")
try:
    st = json.load(open(path))
except (OSError, ValueError):
    st = {"issues": [], "comments": {}, "n": 0}


def save():
    json.dump(st, open(path, "w"))


def flag(name):
    return [a[len(name) + 1:] for a in args if a.startswith(name + "=")]


def page(rows):
    size = int(os.environ.get("DLF_PAGE") or 2)
    return [rows[i:i + size] for i in range(0, max(len(rows), 1), size)]


me = os.environ.get("DLF_FAKE_AS", "loopbot")
url = next((a for a in args if a.startswith("repos/")), "")
post, patch = "POST" in args, "PATCH" in args
if args[:2] == ["api", "user"]:
    print(me)
elif url.endswith("/comments") or "/comments?" in url:
    num = url.split("/issues/")[1].split("/")[0]
    if post:
        st["n"] += 1
        st["comments"].setdefault(num, []).append({"id": st["n"], "user": {"login": me}, "body": flag("body")[0], "created_at": "2026-11-24T10:%02d:00Z" % st["n"]})
        save()
        if os.environ.get("DLF_FAKE_TIMEOUT"):
            sys.exit("gh: timeout after the write")
        print(json.dumps(st["comments"][num][-1]))
    else:
        if os.environ.get("DLF_FAKE_FAIL") == "comments":
            sys.exit("gh: HTTP 502")
        print(json.dumps(page(st["comments"].get(num, []))))
elif "/issues/" in url and patch:
    for i in st["issues"]:
        if str(i["number"]) == url.rsplit("/", 1)[1]:
            i["state"] = flag("state")[0]
    save()
    print("{}")
elif "/issues" in url and post:
    st["n"] += 1
    i = {"number": len(st["issues"]) + 1, "title": flag("title")[0], "body": flag("body")[0], "state": "open",
         "labels": [{"name": n} for n in flag("labels[]")], "html_url": "https://example.test/issues/%d" % (len(st["issues"]) + 1)}
    st["issues"].append(i)
    save()
    print(json.dumps(i))
elif "/issues" in url:
    if os.environ.get("DLF_FAKE_FAIL") in ("list", "issues"):
        sys.exit("gh: HTTP 502")
    want = url.split("labels=")[1].split("&")[0].replace("%3A", ":") if "labels=" in url else ""
    print(json.dumps(page([i for i in st["issues"] if not want or want in [x["name"] for x in i["labels"]]])))
else:
    sys.exit("dlf-gh: unhandled " + " ".join(args))

{
  "base": "main",
  "agent_command": [
    "claude",
    "-p",
    "--model=sonnet",
    "--allowedTools=Bash,Read,Write,Edit,Skill"
  ],
  "parallel": 0,
  "risky_paths": [
    "^\\.github/",
    "(^|/)auth",
    "(^|/)migrations?/",
    "(^|/)(schema|data)\\b"
  ],
  "version_file": "VERSION",
  "wiki_dir": "docs/wiki",
  "pr_bumps_version": false,
  "mend": true,
  "resume_on_limit": false,
  "workers": "app",
  "criteria": true,
  "criteria_max": 24,
  "max_suite_seconds": 2800,
  "auto_approve": true,
  "auto_merge": true,
  "merge_queue": false,
  "regression_cron": "17 */4 * * *",
  "health_cron": "47 */4 * * *",
  "judge_env": "ANTHROPIC_API_KEY",
  "judge_setup": "",
  "digest_owner": "",
  "routines": [],
  "time_budget_minutes": 240,
  "token_budget": 3000000,
  "max_regression_rows": 1300,
  "review_depth": "full",
  "_help": {
    "review_depth": "full runs the plan and review skills' whole pipeline and refuses a condensed one; condensed allows a shorter run.",
    "criteria_max": "Most criteria a wiki page may hold, 1 to 50, default 10; docs check and health fail a page over it."
  },
  "full_auto": true,
  "pool_size": 20,
  "silent_minutes": 30,
  "min_free_memory_gb": 3.0,
  "govern_hook": true,
  "digest_mail": "cloudflare",
  "test_budget_minutes": 15,
  "step_budget_minutes": 30,
  "prep_budget_minutes": 25,
  "cadence": "30",
  "smtp_host": "smtp.gmail.com",
  "smtp_port": 465,
  "step_limit": 0,
  "goal_lane_minutes": 10,
  "goal_levels": "land",
  "ci_levels": "nightly",
  "stale_branch_days": 14,
  "mend_wait": 120,
  "max_tries": 3,
  "limit_wait": 1800,
  "watch_interval": 20,
  "agent_files": [
    "CLAUDE.md",
    "AGENTS.md"
  ],
  "template_repo": "",
  "reply_hook": true,
  "feature_labels": false,
  "template_version": "0.27.29",
  "regression_runs": "actions",
  "max_merge_rounds": 8,
  "merge_batch": true,
  "max_active_goals": 20,
  "plan_pause_percent": 80,
  "health_script_bytes": 20480,
  "health_skill_lines": 150,
  "public_origins": [
    "https://12factor.net",
    "https://adr.github.io",
    "https://agentskills.io",
    "https://blogs.eclipse.org",
    "https://cli.github.com",
    "https://cncf.io",
    "https://containers.dev",
    "https://copier.readthedocs.io",
    "https://csrc.nist.gov",
    "https://diataxis.fr",
    "https://docs.cucumber.io",
    "https://docs.github.com",
    "https://docs.gitlab.com",
    "https://docs.openstack.org",
    "https://docs.renovatebot.com",
    "https://docs.sonarsource.com",
    "https://dora.dev",
    "https://en.wikipedia.org",
    "https://eslint.org",
    "https://github.com/Charlie-org146",
    "https://github.com/jcl2018",
    "https://github.com/actions/stale",
    "https://github.com/bors-ng/bors-ng",
    "https://github.com/DavidAnson/markdownlint",
    "https://github.com/gitleaks/gitleaks",
    "https://github.com/in-toto/attestation",
    "https://github.com/ossf/scorecard",
    "https://github.com/twpayne/chezmoi",
    "https://jestjs.io",
    "https://kubernetes.io",
    "https://modelcontextprotocol.io",
    "https://npmjs.com",
    "https://nx.dev",
    "https://opengitops.dev",
    "https://playwright.dev",
    "https://pre-commit.com",
    "https://reproducible-builds.org",
    "https://research.google",
    "https://rework.withgoogle.com",
    "https://semver.org",
    "https://sre.google",
    "https://standards.ieee.org",
    "https://support.pagerduty.com",
    "https://temporal.io",
    "https://testing.googleblog.com",
    "https://ubuntu.com",
    "https://www.agensi.io",
    "https://www.atlassian.com",
    "https://www.conventionalcommits.org",
    "https://www.finops.org",
    "https://www.gitguardian.com",
    "https://www.joelonsoftware.com",
    "https://www.thoughtworks.com",
    "https://www.uber.com",
    "https://www.writethedocs.org"
  ],
  "topics": {
    "Build loop": [
      "Delivery",
      "Monitoring",
      "Operation",
      "Check-in-and-board"
    ],
    "Quality": [
      "Regression",
      "Health",
      "Guardrails"
    ],
    "Operations": [
      "Automation",
      "Setup",
      "Machines"
    ],
    "Docs": [
      "Documentation"
    ]
  },
  "automation": [
    {
      "name": "health",
      "does": "Checks the repo, files findings.",
      "cadence": "47 */4 * * *",
      "runs": "mac:agent-workflow-template-health-regression"
    },
    {
      "name": "regression",
      "does": "Runs the regression rows.",
      "cadence": "17 */4 * * *",
      "runs": "mac:agent-workflow-template-health-regression"
    },
    {
      "name": "digest email",
      "does": "Mails the round's digest.",
      "cadence": "with each health round",
      "runs": "mac:agent-workflow-template-health-regression"
    }
  ]
}
